---
// パラメータ式のキャラポートレート(全て自作SVG)。
// 性別で顔立ちを、髪型パーツ・種族パーツ(耳・宝石など)でキャラを描き分ける。
interface Props {
  id: string;
  size?: number;
  classKey?: string | null; // 種族キー(human/superd/...) → 背景色
}

type Cfg = {
  gender: 'm' | 'f';
  front: 'flat' | 'side' | 'curtain' | 'messy' | 'neat' | 'spiky' | 'slick' | 'hime' | 'buzz' | 'none';
  back: 'short-m' | 'mid' | 'bob' | 'long' | 'wavy' | 'ponytail' | 'twin' | 'buns' | 'mane' | 'topknot' | 'braid' | 'none';
  hair: string;
  eyes: string;
  expr: 'neutral' | 'smile' | 'smirk' | 'shy' | 'fierce' | 'soft';
  glasses?: boolean;
  ribbon?: string;   // 髪飾り
  jacket?: string;   // 上着(ローブ・旅装)の色の上書き
  skin?: string;     // 肌色の上書き(褐色・魔族など)
  ears?: 'elf' | 'beast'; // エルフの長耳 / 獣族のけもの耳
  gem?: boolean;     // 額の宝石(スペルド族)
  eyepatch?: boolean; // 眼帯(ギレーヌ)
  mask?: boolean;    // 白い仮面(ナナホシ)
  hairband?: string; // カチューシャ/ヘッドドレス(リーリャ)
};

const CONFIGS: Record<string, Cfg> = {
  // --- グレイラット家とブエナ村 ---
  rudeus: { gender: 'm', front: 'messy', back: 'short-m', hair: '#9a8265', eyes: '#5f7a52', expr: 'neutral', jacket: '#57604a' },
  paul: { gender: 'm', front: 'messy', back: 'mid', hair: '#8a6a4f', eyes: '#6b5741', expr: 'smirk', jacket: '#6b4f3a' },
  zenith: { gender: 'f', front: 'side', back: 'long', hair: '#e8cf7e', eyes: '#4a8ad0', expr: 'smile', jacket: '#e8e2d0' },
  lilia: { gender: 'f', front: 'side', back: 'bob', hair: '#a8a49a', eyes: '#5f5a4a', expr: 'neutral', jacket: '#4a4440', hairband: '#f5f1e6' },
  aisha: { gender: 'f', front: 'side', back: 'ponytail', hair: '#bdb9af', eyes: '#6b5741', expr: 'smile', jacket: '#5a4f40', ribbon: '#d94f6d' },
  norn: { gender: 'f', front: 'curtain', back: 'bob', hair: '#d8c078', eyes: '#4a8ad0', expr: 'shy', jacket: '#6b5f8a' },
  sylphy: { gender: 'f', front: 'flat', back: 'bob', hair: '#a8d8b0', eyes: '#7a5f4a', expr: 'soft', ears: 'elf', jacket: '#6a8a5f' },
  // --- 師匠たち ---
  roxy: { gender: 'f', front: 'hime', back: 'braid', hair: '#6a9ad0', eyes: '#5a7ab8', expr: 'neutral', jacket: '#3f4a6b' },
  ghislaine: { gender: 'f', front: 'flat', back: 'short-m', hair: '#e0d8c8', eyes: '#d0b040', expr: 'fierce', skin: '#b07a52', ears: 'beast', eyepatch: true, jacket: '#5a4f40' },
  // --- 旅の仲間 ---
  eris: { gender: 'f', front: 'side', back: 'wavy', hair: '#c4372f', eyes: '#a05a3f', expr: 'fierce', jacket: '#8a3040' },
  ruijerd: { gender: 'm', front: 'spiky', back: 'mid', hair: '#3fae87', eyes: '#4a6a5a', expr: 'fierce', gem: true, jacket: '#4a5548' },
  // --- ラノア魔法大学 ---
  cliff: { gender: 'm', front: 'neat', back: 'short-m', hair: '#8a5a44', eyes: '#5f4a3d', expr: 'neutral', jacket: '#6b5f8a' },
  zanoba: { gender: 'm', front: 'buzz', back: 'short-m', hair: '#6b5a3f', eyes: '#6b5741', expr: 'smile', jacket: '#7a6a45' },
  nanahoshi: { gender: 'f', front: 'curtain', back: 'long', hair: '#2a2731', eyes: '#4a3f35', expr: 'neutral', mask: true, jacket: '#4a4455' },
  // --- 強者たち・七大列強 ---
  kishirika: { gender: 'f', front: 'flat', back: 'twin', hair: '#5a2a7a', eyes: '#d05f8a', expr: 'smile', skin: '#e8c8b0', jacket: '#3a2a45' },
  badigadi: { gender: 'm', front: 'buzz', back: 'none', hair: '#1d1a12', eyes: '#d0b040', expr: 'smile', skin: '#6a5a8a', jacket: '#3a2a45' },
  orsted: { gender: 'm', front: 'neat', back: 'mid', hair: '#e0ded8', eyes: '#c0a030', expr: 'fierce', jacket: '#2a2a35' },
  // --- ボレアス家とフィットア領 ---
  sauros: { gender: 'm', front: 'spiky', back: 'short-m', hair: '#a04b3a', eyes: '#6b4444', expr: 'fierce', jacket: '#6b2a2a' },
  philip: { gender: 'm', front: 'neat', back: 'short-m', hair: '#8a4b3a', eyes: '#6b5741', expr: 'smirk', jacket: '#5a3a5a' },
  hilda: { gender: 'f', front: 'hime', back: 'long', hair: '#a04b3a', eyes: '#96543f', expr: 'neutral', jacket: '#7a3040' },
  // --- 魔法大学とその周辺 ---
  rinia: { gender: 'f', front: 'side', back: 'short-m', hair: '#d8b060', eyes: '#8a6d3f', expr: 'smirk', ears: 'beast', jacket: '#6b5f8a' },
  pursena: { gender: 'f', front: 'flat', back: 'long', hair: '#c8c2b4', eyes: '#a05a3f', expr: 'smile', ears: 'beast', jacket: '#6b5f8a' },
  ariel: { gender: 'f', front: 'hime', back: 'long', hair: '#e8d47e', eyes: '#7a5fd0', expr: 'soft', jacket: '#6b5f8a' },
  luke: { gender: 'm', front: 'neat', back: 'short-m', hair: '#d9bd5f', eyes: '#7a6a45', expr: 'smirk', jacket: '#565b66' },
  ginger: { gender: 'f', front: 'side', back: 'ponytail', hair: '#b0685a', eyes: '#6b5741', expr: 'neutral', jacket: '#565b66' },
  // --- 旅の仲間(捜索隊) ---
  elinalise: { gender: 'f', front: 'curtain', back: 'wavy', hair: '#e8cf7e', eyes: '#5f9a3f', expr: 'soft', ears: 'elf', jacket: '#7a86b8' },
  talhand: { gender: 'm', front: 'buzz', back: 'none', hair: '#6b5a3f', eyes: '#4a4a40', expr: 'neutral', jacket: '#4a4440' },
  geese: { gender: 'm', front: 'messy', back: 'short-m', hair: '#4a5548', eyes: '#5f4a3d', expr: 'smirk', skin: '#d8a878', jacket: '#7a6a45' },
  // --- シーローン・アスラ・列強 ---
  pax: { gender: 'm', front: 'neat', back: 'short-m', hair: '#4a4f5a', eyes: '#5a4a7a', expr: 'smirk', jacket: '#6b5f8a' },
  randolph: { gender: 'm', front: 'curtain', back: 'short-m', hair: '#8d8d97', eyes: '#5a5a6a', expr: 'smile', jacket: '#3a3230' },
  alek: { gender: 'm', front: 'neat', back: 'mid', hair: '#e8cf7e', eyes: '#4a8ad0', expr: 'smirk', jacket: '#3f4a6b' },
  reida: { gender: 'f', front: 'side', back: 'buns', hair: '#d8d8dc', eyes: '#4a4a55', expr: 'fierce', jacket: '#3a4a5a' },
  'gal-farion': { gender: 'm', front: 'none', back: 'topknot', hair: '#8a6a4f', eyes: '#7a2d22', expr: 'smirk', jacket: '#8a3040' },
  perugius: { gender: 'm', front: 'slick', back: 'mid', hair: '#e0ded8', eyes: '#c0a030', expr: 'fierce', jacket: '#b8a468' },
  atofe: { gender: 'f', front: 'flat', back: 'mane', hair: '#e0d8c8', eyes: '#c22843', expr: 'fierce', skin: '#b07a52', jacket: '#6b2a2a' },
};

// 種族ごとのカード背景色
const RACE_BG: Record<string, string> = {
  human: '#f0e7d4',
  superd: '#dcefe4',
  migurd: '#dde9f5',
  elf: '#e4f0d8',
  beast: '#f8ecd9',
  demon: '#ede5fb',
  dragon: '#f9e2e6',
  other: '#e7ebe6',
};

const { id, size = 96, classKey } = Astro.props;
const cfg = CONFIGS[id];
const bg = (classKey && RACE_BG[classKey]) || '#ece4d0';
const skin = cfg?.skin ?? '#ffe8d8';
// 上着: 既定は旅装の焦茶。キャラごとにローブ等の色で上書き
const jacket = cfg?.jacket ?? '#6b5a3f';
const darker = (hex: string) => {
  const n = parseInt(hex.slice(1), 16);
  const f = (v: number) => Math.max(0, Math.round(v * 0.72));
  return `#${((f(n >> 16) << 16) | (f((n >> 8) & 255) << 8) | f(n & 255)).toString(16).padStart(6, '0')}`;
};
const isM = cfg?.gender === 'm';
---

{cfg ? (
  <svg viewBox="0 0 120 120" width={size} height={size} role="img" aria-label={`${id}のイラスト`}>
    <clipPath id={`clip-${id}`}><circle cx="60" cy="60" r="58" /></clipPath>
    <g clip-path={`#clip-${id}`} style={`clip-path: url(#clip-${id})`}>
      <rect width="120" height="120" fill={bg} />

      {/* 後ろ髪 */}
      {cfg.back === 'short-m' && <path d="M33 58 Q29 36 42 27 Q52 21 60 21 Q68 21 78 27 Q91 36 87 58 Q74 52 60 52 Q46 52 33 58 Z" fill={cfg.hair} />}
      {cfg.back === 'topknot' && (
        <>
          <path d="M33 58 Q29 36 42 27 Q52 21 60 21 Q68 21 78 27 Q91 36 87 58 Q74 52 60 52 Q46 52 33 58 Z" fill={cfg.hair} />
          <circle cx="63" cy="19" r="6.5" fill={cfg.hair} />
        </>
      )}
      {cfg.back === 'mane' && (
        <>
          <path d="M33 58 Q29 34 42 25 Q52 19 60 19 Q68 19 78 25 Q91 34 87 58 Q74 52 60 52 Q46 52 33 58 Z" fill={cfg.hair} />
          <path d="M31 54 Q27 76 33 94 L37 76 L39 90 L43 68 L44 56 Z" fill={cfg.hair} />
          <path d="M89 54 Q93 76 87 94 L83 76 L81 90 L77 68 L76 56 Z" fill={cfg.hair} />
        </>
      )}
      {cfg.back === 'mid' && <path d="M30 88 Q24 52 38 32 Q48 21 60 21 Q72 21 82 32 Q96 52 90 88 Q76 95 60 95 Q44 95 30 88 Z" fill={cfg.hair} />}
      {cfg.back === 'bob' && <path d="M28 92 Q22 62 32 42 Q42 21 60 21 Q78 21 88 42 Q98 62 92 92 Q76 100 60 100 Q44 100 28 92 Z" fill={cfg.hair} />}
      {cfg.back === 'buns' && (
        <>
          <path d="M28 88 Q22 60 32 42 Q42 22 60 22 Q78 22 88 42 Q98 60 92 88 Q76 96 60 96 Q44 96 28 88 Z" fill={cfg.hair} />
          <circle cx="34" cy="27" r="7.5" fill={cfg.hair} />
          <circle cx="86" cy="27" r="7.5" fill={cfg.hair} />
        </>
      )}
      {cfg.back === 'long' && <path d="M24 118 Q18 70 30 44 Q40 20 60 20 Q80 20 90 44 Q102 70 96 118 Z" fill={cfg.hair} />}
      {cfg.back === 'wavy' && (
        <>
          <path d="M24 112 Q17 70 30 44 Q40 20 60 20 Q80 20 90 44 Q103 70 96 112 Z" fill={cfg.hair} />
          <circle cx="28" cy="86" r="8" fill={cfg.hair} />
          <circle cx="24" cy="102" r="8" fill={cfg.hair} />
          <circle cx="92" cy="86" r="8" fill={cfg.hair} />
          <circle cx="96" cy="102" r="8" fill={cfg.hair} />
        </>
      )}
      {cfg.back === 'ponytail' && (
        <>
          <path d="M32 76 Q26 52 36 36 Q46 22 60 22 Q74 22 84 36 Q94 52 88 76 Q74 84 60 84 Q46 84 32 76 Z" fill={cfg.hair} />
          <path d="M80 24 Q108 24 104 62 Q101 94 90 112 Q85 92 86 68 Q88 42 76 30 Z" fill={cfg.hair} />
          <circle cx="83" cy="28" r="5" fill={cfg.hair} />
        </>
      )}
      {cfg.back === 'twin' && (
        <>
          <path d="M32 76 Q26 52 36 36 Q46 22 60 22 Q74 22 84 36 Q94 52 88 76 Q74 84 60 84 Q46 84 32 76 Z" fill={cfg.hair} />
          <path d="M30 38 Q10 48 15 84 Q18 104 27 116 Q32 96 30 74 Q28 52 37 40 Z" fill={cfg.hair} />
          <path d="M90 38 Q110 48 105 84 Q102 104 93 116 Q88 96 90 74 Q92 52 83 40 Z" fill={cfg.hair} />
        </>
      )}
      {cfg.back === 'braid' && (
        <>
          <path d="M32 76 Q26 52 36 36 Q46 22 60 22 Q74 22 84 36 Q94 52 88 76 Q74 84 60 84 Q46 84 32 76 Z" fill={cfg.hair} />
          <circle cx="86" cy="58" r="7" fill={cfg.hair} />
          <circle cx="90" cy="72" r="6.5" fill={cfg.hair} />
          <circle cx="92" cy="86" r="6" fill={cfg.hair} />
          <circle cx="93" cy="99" r="5.5" fill={cfg.hair} />
          <path d="M92 104 L96 114 L89 112 Z" fill={cfg.hair} />
        </>
      )}

      {/* 体・旅装(ローブ/チュニック) */}
      {isM ? (
        <>
          <path d="M22 120 Q24 93 44 89 L60 87 L76 89 Q96 93 98 120 Z" fill={jacket} />
          <path d="M46 91 L60 87 L74 91 L66 108 Q60 101 54 108 Z" fill="#f5f1e6" />
          <path d="M55 92 L60 89 L65 92 L60 101 Z" fill={skin} />
          <path d="M56 99 L60 108 L64 99" stroke={darker(jacket)} stroke-width="1.6" fill="none" />
        </>
      ) : (
        <>
          <path d="M28 120 Q30 96 46 92 L60 90 L74 92 Q90 96 92 120 Z" fill={jacket} />
          <path d="M52 92 L60 90 L68 92 L64 103 L60 97 L56 103 Z" fill="#f5f1e6" />
          <path d="M57 97 L60 104 L63 97" stroke={darker(jacket)} stroke-width="1.4" fill="none" />
        </>
      )}

      {/* 顔 */}
      {isM ? (
        <path d="M38 52 Q38 27 60 27 Q82 27 82 52 Q82 67 75 75 Q67 81 60 81 Q53 81 45 75 Q38 67 38 52 Z" fill={skin} />
      ) : (
        <path d="M38 52 Q38 28 60 28 Q82 28 82 52 Q82 66 74 74 Q67 80 60 80 Q53 80 46 74 Q38 66 38 52 Z" fill={skin} />
      )}
      {cfg.ears === 'elf' ? (
        <>
          <path d="M40 56 L26 48 Q30 60 40 62 Z" fill={skin} />
          <path d="M80 56 L94 48 Q90 60 80 62 Z" fill={skin} />
        </>
      ) : (
        <>
          <ellipse cx="38" cy="56" rx="3.4" ry="5" fill={skin} />
          <ellipse cx="82" cy="56" rx="3.4" ry="5" fill={skin} />
        </>
      )}
      {cfg.ears === 'beast' && (
        <g>
          <path d="M34 30 L28 12 L46 22 Z" fill={cfg.hair} />
          <path d="M86 30 L92 12 L74 22 Z" fill={cfg.hair} />
          <path d="M35 27 L31 16 L42 22 Z" fill="#f0c8b8" />
          <path d="M85 27 L89 16 L78 22 Z" fill="#f0c8b8" />
        </g>
      )}

      {/* 目 (男性は細め+上まぶたライン、女性は大きめ) */}
      {isM ? (
        <g>
          <ellipse cx="50" cy="59" rx="5.2" ry="4.4" fill="#fff" />
          <ellipse cx="70" cy="59" rx="5.2" ry="4.4" fill="#fff" />
          <ellipse cx="50" cy="59.4" rx="3.8" ry="3.7" fill={cfg.eyes} />
          <ellipse cx="70" cy="59.4" rx="3.8" ry="3.7" fill={cfg.eyes} />
          <circle cx="48.8" cy="58" r="1.2" fill="#fff" />
          <circle cx="68.8" cy="58" r="1.2" fill="#fff" />
          <path d="M44.5 56 Q50 53.5 55.5 56" stroke="#3d3229" stroke-width="1.5" fill="none" stroke-linecap="round" />
          <path d="M64.5 56 Q70 53.5 75.5 56" stroke="#3d3229" stroke-width="1.5" fill="none" stroke-linecap="round" />
        </g>
      ) : (
        <g>
          <ellipse cx="50" cy="58" rx="6" ry={cfg.expr === 'smile' ? 6.4 : 7} fill="#fff" />
          <ellipse cx="70" cy="58" rx="6" ry={cfg.expr === 'smile' ? 6.4 : 7} fill="#fff" />
          <ellipse cx="50" cy="58.5" rx="4.6" ry={cfg.expr === 'smile' ? 5 : 5.8} fill={cfg.eyes} />
          <ellipse cx="70" cy="58.5" rx="4.6" ry={cfg.expr === 'smile' ? 5 : 5.8} fill={cfg.eyes} />
          <circle cx="48.4" cy="56.4" r="1.7" fill="#fff" />
          <circle cx="68.4" cy="56.4" r="1.7" fill="#fff" />
          <circle cx="51.8" cy="60.6" r="0.9" fill="#fff" opacity="0.8" />
          <circle cx="71.8" cy="60.6" r="0.9" fill="#fff" opacity="0.8" />
        </g>
      )}

      {/* 眉 */}
      {isM ? (
        cfg.expr === 'fierce' ? (
          <>
            <path d="M43.5 49 L56 52" stroke={darker(cfg.hair)} stroke-width="2.4" stroke-linecap="round" fill="none" />
            <path d="M76.5 49 L64 52" stroke={darker(cfg.hair)} stroke-width="2.4" stroke-linecap="round" fill="none" />
          </>
        ) : (
          <>
            <path d="M44 51 L56 51.5" stroke={darker(cfg.hair)} stroke-width="2.2" stroke-linecap="round" fill="none" />
            <path d="M64 51.5 L76 51" stroke={darker(cfg.hair)} stroke-width="2.2" stroke-linecap="round" fill="none" />
          </>
        )
      ) : cfg.expr === 'fierce' ? (
        <>
          <path d="M44 48 L56 51" stroke={darker(cfg.hair)} stroke-width="2" stroke-linecap="round" fill="none" />
          <path d="M76 48 L64 51" stroke={darker(cfg.hair)} stroke-width="2" stroke-linecap="round" fill="none" />
        </>
      ) : cfg.expr === 'shy' ? (
        <>
          <path d="M44 50 Q50 48 56 50" stroke={darker(cfg.hair)} stroke-width="1.8" stroke-linecap="round" fill="none" />
          <path d="M64 50 Q70 48 76 50" stroke={darker(cfg.hair)} stroke-width="1.8" stroke-linecap="round" fill="none" />
        </>
      ) : (
        <>
          <path d="M44 49 Q50 46.5 56 48.5" stroke={darker(cfg.hair)} stroke-width="1.8" stroke-linecap="round" fill="none" />
          <path d="M64 48.5 Q70 46.5 76 49" stroke={darker(cfg.hair)} stroke-width="1.8" stroke-linecap="round" fill="none" />
        </>
      )}

      {/* 口 */}
      {cfg.expr === 'smile' && <path d="M55 70 Q60 74.5 65 70" stroke={isM ? '#a05a4a' : '#c25f6d'} stroke-width="2" stroke-linecap="round" fill="none" />}
      {cfg.expr === 'soft' && <path d="M56.5 70.5 Q60 73 63.5 70.5" stroke="#c25f6d" stroke-width="1.8" stroke-linecap="round" fill="none" />}
      {cfg.expr === 'neutral' && <path d="M56 71.5 L64 71.5" stroke={isM ? '#a05a4a' : '#c25f6d'} stroke-width="1.8" stroke-linecap="round" fill="none" />}
      {cfg.expr === 'smirk' && <path d="M55 71 Q61 74 66 69.5" stroke={isM ? '#a05a4a' : '#c25f6d'} stroke-width="2" stroke-linecap="round" fill="none" />}
      {cfg.expr === 'shy' && <path d="M57 71.5 Q60 70.4 63 71.5" stroke="#c25f6d" stroke-width="1.8" stroke-linecap="round" fill="none" />}
      {cfg.expr === 'fierce' && <path d="M55.5 72 Q60 70 64.5 72" stroke={isM ? '#a05a4a' : '#c25f6d'} stroke-width="2" stroke-linecap="round" fill="none" />}

      {/* 頬(女性のみ) */}
      {!isM && (
        <>
          <ellipse cx="45" cy="66" rx="3.6" ry="2" fill="#ffb9b0" opacity="0.55" />
          <ellipse cx="75" cy="66" rx="3.6" ry="2" fill="#ffb9b0" opacity="0.55" />
        </>
      )}

      {/* 前髪 */}
      {cfg.front === 'hime' && <path d="M37 54 Q35 25 60 25 Q85 25 83 54 L80 44 Q70 48.5 60 48.5 Q50 48.5 40 44 Z" fill={cfg.hair} />}
      {cfg.front === 'flat' && <path d="M37 54 Q35 26 60 26 Q85 26 83 54 L78 44 L72 52 L66 42 L60 52 L54 42 L48 52 L42 44 Z" fill={cfg.hair} />}
      {cfg.front === 'side' && <path d="M37 54 Q34 26 60 26 Q86 26 83 54 L79 42 L70 50 L58 38 Q52 48 44 50 L41 44 Z" fill={cfg.hair} />}
      {cfg.front === 'curtain' && <path d="M37 56 Q35 25 60 25 Q85 25 83 56 L77 36 Q72 44 63 46 L60 38 L57 46 Q48 44 43 36 L39 56 Z" fill={cfg.hair} />}
      {cfg.front === 'messy' && <path d="M37 50 Q34 25 60 25 Q86 25 83 50 L80 38 L74 45 L69 36 L63 45 L57 36 L51 45 L45 37 L40 48 Z" fill={cfg.hair} />}
      {cfg.front === 'neat' && <path d="M37 49 Q34 25 60 25 Q86 25 83 49 L80 36 Q66 45 49 41 Q42 39 39 47 Z" fill={cfg.hair} />}
      {cfg.front === 'spiky' && <path d="M37 52 L33 29 L44 39 L47 25 L55 37 L62 23 L68 37 L76 26 L78 40 L87 31 L83 52 L76 41 L68 48 L60 39 L52 48 L43 41 Z" fill={cfg.hair} />}
      {cfg.front === 'buzz' && <path d="M38 44 Q38 24 60 24 Q82 24 82 44 Q82 31 60 30 Q38 31 38 44 Z" fill={cfg.hair} />}
      {cfg.front === 'slick' && (
        <>
          <path d="M36 46 Q33 21 60 21 Q87 21 84 46 Q80 31 60 31 Q40 31 36 46 Z" fill={cfg.hair} />
          <path d="M60 31 L56 42 L61 35 L64 40 Z" fill={cfg.hair} />
        </>
      )}

      {/* 種族・キャラ小物 */}
      {cfg.hairband && <path d="M39 38 Q60 27 81 38" stroke={cfg.hairband} stroke-width="5" fill="none" stroke-linecap="round" />}
      {cfg.gem && <ellipse cx="60" cy="42" rx="3.4" ry="4.2" fill="#c22843" stroke="#8a1830" stroke-width="1" />}
      {cfg.eyepatch && (
        <g>
          <path d="M36 50 L84 60" stroke="#3a3230" stroke-width="2.4" fill="none" />
          <ellipse cx="70" cy="58" rx="8" ry="7" fill="#3a3230" />
        </g>
      )}
      {cfg.mask && (
        <g>
          <path d="M40 50 Q40 44 60 44 Q80 44 80 50 Q80 66 60 67 Q40 66 40 50 Z" fill="#f5f1e6" stroke="#c8bfa8" stroke-width="1.2" />
          <ellipse cx="50" cy="56" rx="4.4" ry="2.4" fill="#3a3230" />
          <ellipse cx="70" cy="56" rx="4.4" ry="2.4" fill="#3a3230" />
        </g>
      )}
      {cfg.glasses && (
        <g stroke="#5a6478" stroke-width="1.6" fill="none" opacity="0.9">
          <rect x="42.5" y="52" width="15" height="11.5" rx="5" />
          <rect x="62.5" y="52" width="15" height="11.5" rx="5" />
          <path d="M57.5 57 Q60 55.5 62.5 57" />
        </g>
      )}
      {cfg.ribbon && cfg.back === 'ponytail' && (
        <g fill={cfg.ribbon}>
          <path d="M81 26 L89 19 L89 29 Z" />
          <path d="M81 26 L88 34 L79 33 Z" />
          <circle cx="82" cy="27" r="2.4" />
        </g>
      )}
      {cfg.ribbon && cfg.back === 'twin' && (
        <g fill={cfg.ribbon}>
          <circle cx="33" cy="40" r="3" />
          <circle cx="87" cy="40" r="3" />
        </g>
      )}
      {cfg.ribbon && cfg.back !== 'ponytail' && cfg.back !== 'twin' && (
        <g fill={cfg.ribbon}>
          <path d="M84 33 L92 27 L91 36 Z" />
          <path d="M84 33 L90 41 L82 40 Z" />
          <circle cx="84.5" cy="34.5" r="2.2" />
        </g>
      )}
    </g>
    <circle cx="60" cy="60" r="58" fill="none" stroke="rgb(58 45 35 / 0.15)" stroke-width="2" />
  </svg>
) : (
  <svg viewBox="0 0 120 120" width={size} height={size} role="img" aria-label="シルエット">
    <clipPath id={`clip-sil-${id}`}><circle cx="60" cy="60" r="58" /></clipPath>
    <g clip-path={`#clip-sil-${id}`} style={`clip-path: url(#clip-sil-${id})`}>
      <rect width="120" height="120" fill={bg} />
      <circle cx="60" cy="48" r="20" fill="#b0a48e" />
      <path d="M24 120 Q28 84 60 84 Q92 84 96 120 Z" fill="#b0a48e" />
    </g>
    <circle cx="60" cy="60" r="58" fill="none" stroke="rgb(58 45 35 / 0.15)" stroke-width="2" />
  </svg>
)}
