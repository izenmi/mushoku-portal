---
import Base from '../../layouts/Base.astro';
import battles from '../../data/battles.json';

const base = import.meta.env.BASE_URL;
const arcs = ['幼年期・少年期', '魔大陸・帰還編', '魔法大学編', '青年期・転換点', '青年期後半', '決戦・完結編'];
---

<Base title="戦い・事件の記録" description="無職転生の主要な戦い・事件のあらましと結末を年表形式で整理。ネタバレは読了位置に応じて自動で隠されます。">
  <h1>🛡️ 戦い・事件の記録</h1>
  <p class="muted">物語を動かした主要な戦い・事件のアーカイブ。読了位置(右上📖)より先の出来事は内容を伏せています。</p>

  {arcs.map((arc) => (
    <section>
      <h2 class="section-title">{arc}</h2>
      <div class="timeline" data-sp-count>
        <p class="sp-note"></p>
        {battles.filter((e) => e.arc === arc).map((e) => (
          <div class="timeline-item" data-sp={e.sp > 1 ? e.sp : undefined}>
            <div class="timeline-marker">
              <span class="vol-badge">{e.vol}巻</span>
            </div>
            <a href={`${base}battles/${e.id}/`} class="card battle-card">
              <div class="battle-head">
                <strong>{e.name}</strong>
                <span class="type-tag">{e.type}</span>
              </div>
              <p class="muted battle-place">{e.place}</p>
              <p class="battle-rule">{e.rule.length > 90 ? e.rule.slice(0, 90) + '…' : e.rule}</p>
            </a>
          </div>
        ))}
      </div>
    </section>
  ))}

  <style>
    .timeline { position: relative; padding-left: 4px; }
    .timeline-item {
      display: grid;
      grid-template-columns: 64px 1fr;
      gap: 12px;
      margin-bottom: 14px;
    }
    .timeline-marker { position: relative; text-align: center; padding-top: 12px; }
    .timeline-marker::before {
      content: "";
      position: absolute;
      left: 50%;
      top: 0;
      bottom: -14px;
      width: 2px;
      background: var(--line);
      z-index: 0;
    }
    .timeline-item:last-child .timeline-marker::before { bottom: auto; height: 100%; }
    .vol-badge {
      position: relative; z-index: 1;
      display: inline-block;
      background: var(--navy); color: var(--navy-ink);
      font-size: 0.72rem; font-weight: 700;
      border-radius: 999px; padding: 3px 8px;
    }
    .battle-card { display: block; padding: 14px 16px; text-decoration: none; }
    .battle-card:hover { border-color: var(--accent); }
    .battle-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .battle-head strong { font-size: 1.02rem; }
    .type-tag {
      font-size: 0.72rem; font-weight: 700;
      background: var(--accent-soft); color: var(--accent);
      border-radius: 6px; padding: 2px 8px;
    }
    .battle-place { font-size: 0.8rem; margin: 4px 0; }
    .battle-rule { font-size: 0.88rem; margin: 0; color: var(--ink-2); }
  </style>
</Base>
