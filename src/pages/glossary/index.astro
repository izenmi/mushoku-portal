---
import Base from '../../layouts/Base.astro';
import glossary from '../../data/glossary.json';
import timeline from '../../data/timeline.json';

const spLabel = (sp: number) => timeline.volumes.find((v) => v.ord === sp)?.label ?? '';

const TIERS = ['初級', '中級', '上級', '聖級', '王級', '帝級', '神級'];
const TIER_COLORS = ['#8a94a3', '#2e8b57', '#2f6fbf', '#b3223c', '#a16207', '#6b21a8', '#1d1a12'];
---

<Base title="用語集・世界観図解" description="魔術階級・剣術三大流派・七大列強など、無職転生の世界の仕組みを図解付きで解説。">
  <h1>📖 用語集・世界観図解</h1>
  <p class="muted">
    六面世界の仕組みを図解付きでまとめました。ネタバレを含む用語は読了位置に応じて隠されます。
  </p>

  <nav class="card gl-toc">
    {glossary.map((c) => <a href={`#${c.category}`}>{c.category}</a>)}
  </nav>

  {glossary.map((c) => (
    <section id={c.category}>
      <h2 class="section-title">{c.category}</h2>

      {c.diagram === 'tiers' && (
        <div class="card gl-diagram">
          <svg viewBox="0 0 700 230" role="img" aria-label="魔術・剣術の階級はしご">
            {TIERS.map((t, i) => (
              <>
                <rect x={20 + i * 95} y={170 - i * 24} width="85" height={40 + i * 24} rx="8" fill={TIER_COLORS[i]} opacity="0.88" />
                <text x={62 + i * 95} y={196 - i * 24} text-anchor="middle" font-size="15" font-weight="800" fill={i === 6 ? '#f0dfa8' : '#fff'}>{t}</text>
              </>
            ))}
            <text x="62" y="150" text-anchor="middle" font-size="11" fill="var(--ink-2)">入門</text>
            <text x="590" y="18" text-anchor="middle" font-size="12" font-weight="700" fill="var(--ink)">人の域を超えた頂</text>
            <path d="M 90 140 Q 350 40 580 30" fill="none" stroke="var(--accent)" stroke-width="3" stroke-dasharray="7 5" marker-end="url(#gl-arrow)" />
            <text x="330" y="60" text-anchor="middle" font-size="12.5" font-weight="800" fill="var(--accent)">魔術も剣術も、この7段階で実力が示される</text>
            <defs>
              <marker id="gl-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
                <path d="M0,0 L8,4 L0,8 Z" fill="var(--accent)" />
              </marker>
            </defs>
          </svg>
        </div>
      )}

      {c.diagram === 'schools' && (
        <div class="card gl-diagram">
          <svg viewBox="0 0 700 190" role="img" aria-label="剣術三大流派の比較図">
            <rect x="20" y="30" width="200" height="130" rx="10" fill="#b3223c" opacity="0.88" />
            <text x="120" y="62" text-anchor="middle" font-size="17" font-weight="800" fill="#fff">剣神流</text>
            <text x="120" y="88" text-anchor="middle" font-size="11.5" fill="#fff">攻撃特化・先手必勝</text>
            <text x="120" y="106" text-anchor="middle" font-size="11.5" fill="#fff">奥義は「光の太刀」</text>
            <text x="120" y="136" text-anchor="middle" font-size="10.5" fill="#ffd9df">エリス / ギレーヌ</text>
            <rect x="250" y="30" width="200" height="130" rx="10" fill="#2f6fb0" opacity="0.88" />
            <text x="350" y="62" text-anchor="middle" font-size="17" font-weight="800" fill="#fff">水神流</text>
            <text x="350" y="88" text-anchor="middle" font-size="11.5" fill="#fff">受け流しと防御の柔</text>
            <text x="350" y="106" text-anchor="middle" font-size="11.5" fill="#fff">相手の力を利用する</text>
            <rect x="480" y="30" width="200" height="130" rx="10" fill="#5a4f40" opacity="0.9" />
            <text x="580" y="62" text-anchor="middle" font-size="17" font-weight="800" fill="#fff">北神流</text>
            <text x="580" y="88" text-anchor="middle" font-size="11.5" fill="#fff">勝つためなら何でも</text>
            <text x="580" y="106" text-anchor="middle" font-size="11.5" fill="#fff">武器も搦め手も自由</text>
            <text x="350" y="180" text-anchor="middle" font-size="11" fill="var(--ink-2)">パウロは三流派すべてを修めた</text>
          </svg>
        </div>
      )}

      {c.diagram === 'world' && (
        <div class="card gl-diagram">
          <svg viewBox="0 0 700 240" role="img" aria-label="六面世界の大陸配置(簡略図)">
            <rect x="250" y="70" width="200" height="100" rx="10" fill="var(--accent)" opacity="0.85" />
            <text x="350" y="112" text-anchor="middle" font-size="15" font-weight="800" fill="#fff">中央大陸</text>
            <text x="350" y="132" text-anchor="middle" font-size="10.5" fill="#fff">アスラ王国・ラノア王国など</text>
            <rect x="490" y="60" width="180" height="90" rx="10" fill="#6b21a8" opacity="0.8" />
            <text x="580" y="98" text-anchor="middle" font-size="14" font-weight="800" fill="#fff">魔大陸</text>
            <text x="580" y="118" text-anchor="middle" font-size="10.5" fill="#fff">魔族の地・過酷な環境</text>
            <rect x="30" y="60" width="180" height="90" rx="10" fill="#2f6fb0" opacity="0.85" />
            <text x="120" y="98" text-anchor="middle" font-size="14" font-weight="800" fill="#fff">ミリス大陸</text>
            <text x="120" y="118" text-anchor="middle" font-size="10.5" fill="#fff">ミリス神聖国・大森林</text>
            <rect x="70" y="175" width="170" height="50" rx="10" fill="#a16207" opacity="0.85" />
            <text x="155" y="205" text-anchor="middle" font-size="12.5" font-weight="800" fill="#fff">ベガリット大陸(砂漠)</text>
            <rect x="300" y="10" width="100" height="40" rx="10" fill="#64748b" opacity="0.8" />
            <text x="350" y="35" text-anchor="middle" font-size="11.5" font-weight="800" fill="#fff">天大陸</text>
            <text x="480" y="205" text-anchor="middle" font-size="10.5" fill="var(--ink-2)">※実際の地理を簡略化したイメージ図です</text>
          </svg>
        </div>
      )}

      {c.diagram === 'powers' && (
        <div class="card gl-diagram">
          <svg viewBox="0 0 700 220" role="img" aria-label="七大列強の序列図">
            <rect x="270" y="10" width="160" height="44" rx="8" fill="#1d1a12" />
            <text x="350" y="38" text-anchor="middle" font-size="14" font-weight="800" fill="#f0dfa8">序列1位 技神</text>
            <rect x="180" y="66" width="160" height="44" rx="8" fill="#6b21a8" opacity="0.9" />
            <text x="260" y="94" text-anchor="middle" font-size="13.5" font-weight="800" fill="#fff">序列2位 龍神</text>
            <rect x="360" y="66" width="160" height="44" rx="8" fill="#b3223c" opacity="0.9" />
            <text x="440" y="94" text-anchor="middle" font-size="13.5" font-weight="800" fill="#fff">序列3位 闘神</text>
            <rect x="90" y="122" width="160" height="44" rx="8" fill="#a16207" opacity="0.9" />
            <text x="170" y="150" text-anchor="middle" font-size="13.5" font-weight="800" fill="#fff">序列4位 魔神</text>
            <rect x="270" y="122" width="160" height="44" rx="8" fill="#2f6fbf" opacity="0.9" />
            <text x="350" y="150" text-anchor="middle" font-size="13.5" font-weight="800" fill="#fff">剣神</text>
            <rect x="450" y="122" width="160" height="44" rx="8" fill="#2e8b57" opacity="0.9" />
            <text x="530" y="150" text-anchor="middle" font-size="13.5" font-weight="800" fill="#fff">死神・北神</text>
            <text x="350" y="195" text-anchor="middle" font-size="11" fill="var(--ink-2)">序列5〜7位の顔ぶれと順位は時代により変動(詳細は強さランキングへ)</text>
          </svg>
        </div>
      )}

      <div class="gl-terms" data-sp-count>
        <p class="sp-note"></p>
        {c.terms.map((t) => (
          <div class="card gl-term" data-sp={t.sp > 1 ? t.sp : undefined} data-sp-label={spLabel(t.sp)}>
            <h3>{t.term} <small class="muted">{t.kana}</small></h3>
            <p>{t.desc}</p>
          </div>
        ))}
      </div>
    </section>
  ))}

  <style>
    .gl-toc {
      display: flex; flex-wrap: wrap; gap: 4px 16px;
      padding: 10px 16px; margin-top: 12px; font-size: 0.88rem;
    }
    .gl-toc a { text-decoration: none; font-weight: 700; }
    .gl-toc a:hover { color: var(--accent); }
    .gl-diagram { padding: 14px; margin-bottom: 12px; }
    .gl-diagram svg { width: 100%; height: auto; display: block; }
    .gl-terms { display: grid; gap: 10px; }
    .gl-term { padding: 12px 18px; }
    .gl-term h3 { margin: 0 0 6px; font-size: 1rem; }
    .gl-term p { margin: 0; font-size: 0.9rem; }
  </style>
</Base>
