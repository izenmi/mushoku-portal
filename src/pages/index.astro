---
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import data from '../data/characters.json';

const base = import.meta.env.BASE_URL;
const pickup = ['rudeus', 'roxy', 'sylphy', 'eris', 'ruijerd', 'orsted']
  .map((id) => data.characters.find((s) => s.id === id)!)
  .filter(Boolean);

const sections = [
  { href: `${base}characters/`, icon: '🗂️', title: '人物名鑑', desc: 'ギルドカード風の全キャラデータベース' },
  { href: `${base}relations/`, icon: '🕸️', title: '人物相関図', desc: '読了位置で変化するインタラクティブ相関図' },
  { href: `${base}ranking/`, icon: '🏆', title: '強さランキング', desc: '七大列強と分野別の実力者を一覧で' },
  { href: `${base}timeline/`, icon: '📜', title: '甲龍暦年表', desc: '転移事件から決戦まで、物語を1本の年表で辿る' },
  { href: `${base}versus/`, icon: '⚔️', title: 'VS比較', desc: '2人の能力チャートを重ねて比較' },
  { href: `${base}battles/`, icon: '🛡️', title: '戦い・事件の記録', desc: '主要な戦いのルールと結末をアーカイブ' },
  { href: `${base}growth/`, icon: '📈', title: 'ルーデウス成長記録', desc: '魔術・剣術・人脈・資産の歩みをグラフで' },
  { href: `${base}taiken/`, icon: '🎭', title: '魔大陸を体験', desc: '転移直後の魔大陸を一人称で体験するADV' },
  { href: `${base}quiz/`, icon: '✏️', title: '原作知識クイズ', desc: '難易度3段階×10問であなたの読み込み度を測定' },
  { href: `${base}shindan/`, icon: '🧭', title: '流派適性診断', desc: 'あなたは剣神流?水神流?北神流?それとも魔術師?' },
  { href: `${base}training/`, icon: '💪', title: '修行場', desc: 'ミニゲームで無詠唱・反射・記憶力を鍛える' },
  { href: `${base}glossary/`, icon: '📖', title: '用語集・図解', desc: '魔術階級や七大列強の仕組みを図解で解説' },
  { href: `${base}anime/`, icon: '📺', title: 'アニメ⇔原作対応表', desc: 'アニメの続きはこの巻から。全3期の対応表' },
  { href: `${base}ages/`, icon: '📅', title: '年齢早見表', desc: '甲龍暦スライダーで各キャラの年齢を確認' },
];
---

<Base>
  <section class="hero card">
    <p class="hero-tag">MUSHOKU TENSEI - JOBLESS REINCARNATION FAN ARCHIVE</p>
    <h1>冒険者ギルド資料室<br /><small class="hero-sub">無職転生ポータル</small></h1>
    <p class="hero-lead">
      34歳・無職で人生を終えた男は、剣と魔術の世界に赤ん坊として生まれ変わった——「今度こそ本気だす」。
      ここは『無職転生 〜異世界行ったら本気だす〜』の世界を、人物名鑑・戦いの記録・甲龍暦の年表から辿る非公式ファンサイトです。
    </p>
    <p class="hero-note">
      📖 右上のボタンで<strong>読了位置</strong>を設定すると、それより先のネタバレは自動で隠されます。アニメから入った方も安心してご利用ください。
    </p>
  </section>

  <section>
    <h2 class="section-title">メニュー</h2>
    <div class="grid menu-grid">
      {sections.map((s) => (
        <a href={s.href} class="card menu-card">
          <span class="menu-icon">{s.icon}</span>
          <strong>{s.title}</strong>
          <p class="muted">{s.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <section>
    <h2 class="section-title">注目の人物</h2>
    <div class="pickup-row">
      {pickup.map((s) => (
        <a
          href={`${base}characters/${s.id}/`}
          class="pickup-card card"
          data-sp={s.sp > 1 ? s.sp : undefined}
          data-sp-hide={s.sp > 1 ? '' : undefined}
        >
          <Portrait id={s.portrait ? s.id : `sil-${s.id}`} size={84} classKey={s.race} />
          <strong>{s.name}</strong>
        </a>
      ))}
    </div>
  </section>

  <style>
    .hero { padding: 30px 26px; border-top: 4px solid var(--accent); }
    .hero-tag { font-size: 0.66rem; letter-spacing: 0.14em; color: var(--ink-2); margin: 0; }
    .hero h1 { font-size: 1.9rem; line-height: 1.3; margin: 8px 0 12px; }
    .hero-sub { font-size: 1rem; color: var(--ink-2); font-weight: 700; }
    .hero-lead { max-width: 46em; }
    .hero-note {
      background: var(--surface-2); border-radius: 10px; padding: 10px 14px;
      font-size: 0.88rem; margin-bottom: 0;
    }
    .menu-grid { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
    .menu-card { padding: 16px; text-decoration: none; }
    .menu-card:hover { border-color: var(--accent); }
    .menu-icon { font-size: 1.5rem; }
    .menu-card strong { display: block; margin: 6px 0 2px; }
    .menu-card p { font-size: 0.8rem; margin: 0; }
    .pickup-row { display: flex; gap: 12px; flex-wrap: wrap; }
    .pickup-card {
      display: flex; flex-direction: column; align-items: center; gap: 6px;
      padding: 14px 18px; text-decoration: none; font-size: 0.88rem;
    }
    .pickup-card:hover { border-color: var(--accent); }
  </style>
</Base>
