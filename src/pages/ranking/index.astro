---
import Base from '../../layouts/Base.astro';
import data from '../../data/characters.json';
import timeline from '../../data/timeline.json';

const base = import.meta.env.BASE_URL;
const spLabel = (sp: number) => timeline.volumes.find((v) => v.ord === sp)?.label ?? '';
const byId = Object.fromEntries((data.characters as any[]).map((s) => [s.id, s]));

// 七大列強(物語開始時点の顔ぶれ。名前は判明する巻までネタバレ防止)
const POWERS = [
  { rank: '1位', title: '技神', id: null, name: '—(正体不明)', sp: 0 },
  { rank: '2位', title: '龍神', id: 'orsted', name: 'オルステッド', sp: 6 },
  { rank: '3位', title: '闘神', id: 'badigadi', name: 'バーディガーディ', sp: 20, est: true },
  { rank: '4位', title: '魔神', id: 'laplace', name: 'ラプラス', sp: 3 },
  { rank: '5〜7位', title: '剣神', id: 'gal-farion', name: 'ガル・ファリオン', sp: 6 },
  { rank: '5〜7位', title: '死神', id: 'randolph', name: 'ランドルフ・マリーアン', sp: 15 },
  { rank: '5〜7位', title: '北神(三代目)', id: 'alek', name: 'アレクサンダー・ライバック', sp: 17 },
];

// 階級の序列(高い順)
const TIER_ORDER = ['神級', '帝級', '王級', '聖級', '上級', '中級', '初級'];
const tierRank = (t: string) => {
  const i = TIER_ORDER.findIndex((x) => t.includes(x));
  return i === -1 ? 99 : i;
};

// 各人物の最高位の魔術系/剣術系階級を拾う
const collect = (kind: 'magic' | 'sword') => {
  const rows: any[] = [];
  for (const s of data.characters as any[]) {
    const tiers = (s.tiers ?? []).filter((t: any) =>
      kind === 'magic' ? /魔術/.test(t.label) : /(剣|流)/.test(t.label)
    );
    if (tiers.length === 0) continue;
    const best = tiers.sort((a: any, b: any) => tierRank(a.tier) - tierRank(b.tier))[0];
    rows.push({ id: s.id, name: s.name, sp: Math.max(s.sp, best.sp), tier: best.tier, label: best.label, est: best.est });
  }
  return rows.sort((a, b) => tierRank(a.tier) - tierRank(b.tier));
};
const magicians = collect('magic');
const swordsmen = collect('sword');
---

<Base title="強さランキング" description="七大列強の序列と、魔術・剣術の階級保持者を一覧で。ネタバレは読了位置に応じて自動で隠されます。">
  <h1>🏆 強さランキング</h1>
  <p class="muted">
    七大列強の序列(物語開始時点)と、当サイト収録人物の階級一覧です。
    名前や階級は、判明する巻まで読了位置に応じて伏せられます。
  </p>

  <section>
    <h2 class="section-title">七大列強<small class="muted">(物語開始時点)</small></h2>
    <div class="card powers-wrap">
      <table class="powers-table">
        <thead><tr><th>序列</th><th>称号</th><th>人物</th></tr></thead>
        <tbody>
          {POWERS.map((p) => (
            <tr>
              <td class="p-rank">{p.rank}</td>
              <td><b class="tier" data-tier="神級">{p.title}</b></td>
              <td>
                {p.sp === 0 ? (
                  <span class="muted">{p.name}</span>
                ) : (
                  <span data-sp={p.sp > 1 ? p.sp : undefined} data-sp-label={spLabel(p.sp)}>
                    {p.id && byId[p.id] ? <a href={`${base}characters/${p.id}/`}>{p.name}</a> : p.name}
                    {p.est && <small class="muted">(管理人整理)</small>}
                  </span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="muted powers-note">序列5〜7位の並びは時期により変動するため一括表記です。列強の顔ぶれ自体も物語中で入れ替わります。</p>
    </div>
  </section>

  <section>
    <h2 class="section-title">魔術の使い手<small class="muted">(収録人物・最高位)</small></h2>
    <div data-sp-count>
      <p class="sp-note"></p>
      <ul class="tier-rows">
        {magicians.map((r) => (
          <li class="card tier-row" data-sp={r.sp > 1 ? r.sp : undefined} data-sp-hide={r.sp > 1 ? '' : undefined}>
            <b class="tier" data-tier={r.tier.replace(/\(.+\)/, '')}>{r.tier}</b>
            <a href={`${base}characters/${r.id}/`}>{r.name}</a>
            <span class="muted">{r.label}{r.est ? '(推定)' : ''}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section>
    <h2 class="section-title">剣・武技の使い手<small class="muted">(収録人物・最高位)</small></h2>
    <div data-sp-count>
      <p class="sp-note"></p>
      <ul class="tier-rows">
        {swordsmen.map((r) => (
          <li class="card tier-row" data-sp={r.sp > 1 ? r.sp : undefined} data-sp-hide={r.sp > 1 ? '' : undefined}>
            <b class="tier" data-tier={r.tier.replace(/\(.+\)/, '')}>{r.tier}</b>
            <a href={`${base}characters/${r.id}/`}>{r.name}</a>
            <span class="muted">{r.label}{r.est ? '(推定)' : ''}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <p class="muted" style="font-size: 0.8rem;">
    階級は原作既述のものを基本とし、推定には印を付けています。数値ではなく階級・称号ベースの整理です。
  </p>

  <style>
    .powers-wrap { padding: 8px 16px 12px; margin-top: 12px; }
    .powers-table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
    .powers-table th {
      text-align: left; font-size: 0.75rem; color: var(--ink-2);
      padding: 8px 10px; border-bottom: 2px solid var(--line);
    }
    .powers-table td { padding: 9px 10px; border-bottom: 1px solid var(--line); }
    .powers-table tr:last-child td { border-bottom: none; }
    .p-rank { font-weight: 800; color: var(--accent); white-space: nowrap; }
    .powers-note { font-size: 0.78rem; margin: 8px 0 0; }
    .tier-rows { list-style: none; padding: 0; display: grid; gap: 8px; }
    .tier-row { padding: 10px 14px; display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
    .tier-row a { font-weight: 700; text-decoration: none; }
    .tier-row a:hover { color: var(--accent); }
    .tier-row .muted { font-size: 0.8rem; }
  </style>
</Base>
