---
import Base from '../../layouts/Base.astro';
import data from '../../data/characters.json';

// chart(時点別スナップショット)を持つ人物だけが比較対象
const vsData: Record<string, any> = {};
for (const s of data.characters as any[]) {
  if (!s.chart || s.chart.length === 0) continue;
  const opts = s.chart.map((h: any, i: number) => ({ key: `e${i}`, label: h.era, sp: h.sp, stats: h }));
  vsData[s.id] = { name: s.name, opts };
}
const ids = Object.keys(vsData);
---

<Base title="VS比較" description="2人の能力チャートを重ねて比較。時点切替・比較URLのシェア対応。">
  <h1>⚔️ VS比較</h1>
  <p class="muted">
    2人を選ぶと能力チャート(管理人推定)が重なって表示されます。時点の切り替えや、
    同一人物の2時点比較(成長の可視化)もできます。
  </p>

  <div class="card panel vs-controls">
    {['a', 'b'].map((side) => (
      <div class={`vs-side vs-side-${side}`}>
        <span class={`vs-dot vs-dot-${side}`}></span>
        <select id={`vs-sel-${side}`} class="vs-select">
          {ids.map((id) => (
            <option value={id}>{vsData[id].name}</option>
          ))}
        </select>
        <div id={`vs-era-${side}`} class="chips"></div>
      </div>
    ))}
  </div>

  <div class="card panel">
    <svg id="vs-chart" viewBox="-40 -6 380 250" width="480" role="img" aria-label="能力比較レーダー"></svg>
    <div id="vs-table"></div>
    <div class="end-actions" style="margin-top: 12px;">
      <button id="vs-copy" class="share-btn">比較URLをコピー</button>
      <a id="vs-share" class="share-btn" target="_blank" rel="noopener">Xでシェア</a>
    </div>
  </div>

  <script is:inline define:vars={{ vsData }}>
    const NS = 'http://www.w3.org/2000/svg';
    const AXES = [['magic', '魔術'], ['sword', '剣・武技'], ['combat', '体術・実戦'], ['wits', '知略']];
    const COLORS = { a: 'var(--accent)', b: '#2f6fb0' };
    const state = { a: 'rudeus', b: 'eris', ea: null, eb: null };

    const progress = () => (window.MUSHOKU ? window.MUSHOKU.progress : 0);
    const usable = (opt) => opt.sp <= Math.max(progress(), 6); // 少年期時点(〜6巻)は常時OK

    const params = new URLSearchParams(location.search);
    if (params.get('a') && vsData[params.get('a')]) state.a = params.get('a');
    if (params.get('b') && vsData[params.get('b')]) state.b = params.get('b');
    state.ea = params.get('ea');
    state.eb = params.get('eb');

    const pickEra = (side) => {
      const d = vsData[state[side]];
      const want = side === 'a' ? state.ea : state.eb;
      const found = d.opts.find((o) => o.key === want && usable(o));
      return found ?? d.opts.find(usable) ?? d.opts[0];
    };

    const renderEraChips = (side) => {
      const d = vsData[state[side]];
      const cur = pickEra(side);
      const box = document.getElementById(`vs-era-${side}`);
      box.innerHTML = '';
      d.opts.forEach((o) => {
        const b = document.createElement('button');
        const locked = !usable(o);
        b.className = 'filter-chip' + (o.key === cur.key ? ' active' : '');
        b.textContent = locked ? `🔒 ${o.label}` : o.label;
        b.disabled = locked;
        b.addEventListener('click', () => {
          if (side === 'a') state.ea = o.key; else state.eb = o.key;
          render();
        });
        box.appendChild(b);
      });
      return cur;
    };

    const el = (tag, attrs, parent) => {
      const n = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(attrs)) n.setAttribute(k, v);
      parent.appendChild(n);
      return n;
    };

    const drawChart = (sa, sb) => {
      const svg = document.getElementById('vs-chart');
      svg.innerHTML = '';
      const cx = 150, cy = 118, r = 88;
      const angle = (i) => (Math.PI / 2) * i - Math.PI / 2;
      const pt = (i, ratio) => [cx + Math.cos(angle(i)) * r * ratio, cy + Math.sin(angle(i)) * r * ratio];
      for (const ratio of [0.25, 0.5, 0.75, 1]) {
        el('polygon', {
          points: [0, 1, 2, 3].map((i) => pt(i, ratio).map((v) => v.toFixed(1)).join(',')).join(' '),
          fill: 'none', stroke: 'var(--line)', 'stroke-width': ratio === 1 ? 1.6 : 1,
        }, svg);
      }
      [0, 1, 2, 3].forEach((i) => {
        const [x, y] = pt(i, 1);
        el('line', { x1: cx, y1: cy, x2: x, y2: y, stroke: 'var(--line)', 'stroke-width': 1 }, svg);
      });
      const labelPos = [
        [cx, cy - r - 10, 'middle'], [cx + r + 10, cy + 4, 'start'],
        [cx, cy + r + 18, 'middle'], [cx - r - 10, cy + 4, 'end'],
      ];
      AXES.forEach(([key, label], i) => {
        const t = el('text', {
          x: labelPos[i][0], y: labelPos[i][1], 'text-anchor': labelPos[i][2],
          'font-size': 12, fill: 'var(--ink-2)',
        }, svg);
        t.textContent = label;
      });
      for (const [side, stats] of [['a', sa], ['b', sb]]) {
        const pts = AXES.map(([key], i) => pt(i, Math.max(0.04, (stats[key]?.[1] ?? 0) / 100)));
        el('polygon', {
          points: pts.map((p) => p.map((v) => v.toFixed(1)).join(',')).join(' '),
          fill: side === 'a' ? 'rgb(23 126 96 / 0.25)' : 'rgb(47 111 176 / 0.25)',
          stroke: COLORS[side], 'stroke-width': 2.4, 'stroke-linejoin': 'round',
        }, svg);
        pts.forEach((p) => el('circle', { cx: p[0], cy: p[1], r: 3, fill: COLORS[side] }, svg));
      }
    };

    const gradeCell = (stats, key) => {
      if (!stats[key]) return '—';
      const [grade, score] = stats[key];
      const badge = grade.includes('級')
        ? `<b class="tier" data-tier="${grade.replace(/\(.+\)/, '')}">${grade}</b>`
        : `<b class="rank" data-rank="${grade}">${grade}</b>`;
      return `${badge} <span class="muted">(${score})</span>`;
    };

    const render = () => {
      const ea = renderEraChips('a');
      const eb = renderEraChips('b');
      const da = vsData[state.a], db = vsData[state.b];
      document.getElementById('vs-sel-a').value = state.a;
      document.getElementById('vs-sel-b').value = state.b;
      drawChart(ea.stats, eb.stats);
      const rows = AXES
        .map(([key, label]) => `<tr><td class="vs-cell-a">${gradeCell(ea.stats, key)}</td><th>${label}</th><td class="vs-cell-b">${gradeCell(eb.stats, key)}</td></tr>`)
        .join('');
      document.getElementById('vs-table').innerHTML = `
        <table class="vs-table">
          <tr>
            <td class="vs-head" style="color: var(--accent)">${da.name}<br><small class="muted">${ea.label}</small></td>
            <th></th>
            <td class="vs-head" style="color: #2f6fb0">${db.name}<br><small class="muted">${eb.label}</small></td>
          </tr>
          ${rows}
        </table>`;
      const url = new URL(location.href);
      url.search = `?a=${state.a}&b=${state.b}&ea=${ea.key}&eb=${eb.key}`;
      history.replaceState(null, '', url);
      const text = `${da.name}(${ea.label}) vs ${db.name}(${eb.label}) を能力チャートで比較! #無職転生`;
      document.getElementById('vs-share').href =
        `https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}&url=${encodeURIComponent(url.href)}`;
    };

    ['a', 'b'].forEach((side) => {
      document.getElementById(`vs-sel-${side}`).addEventListener('change', (ev) => {
        state[side] = ev.target.value;
        if (side === 'a') state.ea = null; else state.eb = null;
        render();
      });
    });
    document.getElementById('vs-copy').addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.href).catch(() => {});
      document.getElementById('vs-copy').textContent = 'コピーしました!';
      setTimeout(() => (document.getElementById('vs-copy').textContent = '比較URLをコピー'), 1500);
    });
    document.addEventListener('mushoku:progress', render);
    window.addEventListener('DOMContentLoaded', render);
  </script>

  <style is:global>
    .vs-controls { display: grid; gap: 14px; }
    @media (min-width: 640px) { .vs-controls { grid-template-columns: 1fr 1fr; } }
    .vs-side { display: flex; flex-direction: column; gap: 8px; }
    .vs-side { border-left: 4px solid var(--line); padding-left: 12px; }
    .vs-side-a { border-color: var(--accent); }
    .vs-side-b { border-color: #2f6fb0; }
    .vs-dot { display: none; }
    .vs-select {
      padding: 8px 10px; border-radius: 8px; border: 1px solid var(--line);
      background: var(--surface); color: var(--ink); font-size: 0.95rem;
    }
    #vs-chart { display: block; max-width: 480px; width: 100%; height: auto; margin: 0 auto; }
    .vs-table { width: 100%; max-width: 480px; margin: 8px auto 0; border-collapse: collapse; font-size: 0.92rem; }
    .vs-table th { font-size: 0.78rem; color: var(--ink-2); padding: 5px 8px; }
    .vs-table td { padding: 5px 8px; text-align: center; }
    .vs-head { font-weight: 800; font-size: 0.95rem; line-height: 1.3; }
    .vs-table tr:not(:first-child) { border-top: 1px solid var(--line); }
  </style>
</Base>
